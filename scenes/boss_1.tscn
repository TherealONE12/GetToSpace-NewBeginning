text = "This is McRichard, my Teacher"
label_settings = SubResource("LabelSettings_0bbe5")

[node name="Intro2" type="Label" parent="." unique_id=1664507295]
visible = false
offset_left = 1463.0
offset_top = 631.0
offset_right = 1798.0
offset_bottom = 668.0
text = "How ofthen do I have to say to you"
label_settings = SubResource("LabelSettings_qscog")

[node name="Intro3" type="Label" parent="." unique_id=1876562667]
visible = false
offset_left = 1463.0
offset_top = 624.0
offset_right = 1588.0
offset_bottom = 677.0
text = "Forget Space! You have to learn!"
label_settings = SubResource("LabelSettings_bcuvt")

[node name="Intro4" type="Label" parent="." unique_id=1509054339]
visible = false
offset_left = 1455.0
offset_top = 624.0
offset_right = 1822.0
offset_bottom = 694.0
text = "You will never make it up there!"
label_settings = SubResource("LabelSettings_kfyxm")

[node name="Intro5" type="Label" parent="." unique_id=2026993797]
visible = false
offset_left = 210.0
offset_top = 604.0
offset_right = 406.0
offset_bottom = 674.0
text = "Yes I will!"
label_settings = SubResource("LabelSettings_uc1rx")

[node name="Intro6" type="Label" parent="." unique_id=306074886]
visible = false
offset_left = 1386.0
offset_top = 626.0
offset_right = 1851.0
offset_bottom = 672.0
text = "Then Prove that you can survive out there"
label_settings = SubResource("LabelSettings_3kv24")

[node name="Intro7" type="Label" parent="." unique_id=1594168883]
visible = false
offset_left = 212.0
offset_top = 624.0
offset_right = 655.0
offset_bottom = 697.0
text = "I will jump on you, 
3 Times to let you see that I am Able!"
label_settings = SubResource("LabelSettings_sa710")

[node name="Intro8" type="Label" parent="." unique_id=1540087530]
visible = false
